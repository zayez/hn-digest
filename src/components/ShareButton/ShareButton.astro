---
import styles from './ShareButton.module.css';

interface Props {
  title: string;
  /** Absolute URL to share. */
  url: string;
  text?: string;
}

const { title, url, text } = Astro.props;
---

<!-- Shares through the OS sheet where there is one, otherwise copies the link. Needs the script. -->
<span class={styles.share} data-share data-pagefind-ignore hidden>
  <button type="button" class={styles.button} data-title={title} data-url={url} data-text={text}>
    Share
  </button>
  <span class={styles.status} role="status"></span>
</span>

<script>
  for (const share of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const button = share.querySelector('button')!;
    const status = share.querySelector<HTMLElement>('[role="status"]')!;
    const { title, url = location.href, text } = button.dataset;
    share.hidden = false;

    button.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, text, url });
        } catch {
          // Dismissing the share sheet rejects too; there is nothing to report.
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Link copied';
      } catch {
        status.textContent = 'Couldn’t copy the link';
      }
      setTimeout(() => (status.textContent = ''), 2500);
    });
  }
</script>
