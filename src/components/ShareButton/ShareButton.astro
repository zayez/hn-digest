---
import styles from './ShareButton.module.css';

interface Props {
  title: string;
  /** Absolute URL to share. */
  url: string;
}

const { title, url } = Astro.props;
---

<!-- Shares through the OS sheet where there is one, otherwise copies the title and link. Needs the script. -->
<span class={styles.share} data-share data-pagefind-ignore hidden>
  <button type="button" class={styles.button} data-title={title} data-url={url}>
    Share
  </button>
  <span class={styles.status} role="status"></span>
</span>

<script>
  /** Rich editors (Slack, Docs, mail) paste a titled link; plain-text fields get title and URL. */
  async function copyLink(title: string, url: string, plain: string) {
    if (typeof ClipboardItem === 'undefined') return navigator.clipboard.writeText(plain);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.textContent = title;
    await navigator.clipboard.write([
      new ClipboardItem({
        'text/plain': new Blob([plain], { type: 'text/plain' }),
        'text/html': new Blob([anchor.outerHTML], { type: 'text/html' }),
      }),
    ]);
  }

  for (const share of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const button = share.querySelector('button')!;
    const status = share.querySelector<HTMLElement>('[role="status"]')!;
    const { title = document.title, url = location.href } = button.dataset;
    const plain = `${title}\n${url}`;
    share.hidden = false;

    button.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          // No separate `url`: Android hands apps a single text, and with a `url` set apps like
          // Bluesky got the link alone. With the link inside `text`, they still build a link card.
          await navigator.share({ title, text: plain });
        } catch {
          // Dismissing the share sheet rejects too; there is nothing to report.
        }
        return;
      }
      try {
        await copyLink(title, url, plain);
        status.textContent = 'Title and link copied';
      } catch {
        status.textContent = 'Couldn’t copy the link';
      }
      setTimeout(() => (status.textContent = ''), 2500);
    });
  }
</script>
