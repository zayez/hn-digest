---
import '../styles/theme.css';
import '../styles/base.css';
import SearchForm from '../components/SearchForm/SearchForm.astro';
import center from '../styles/objects/center.module.css';
import cluster from '../styles/objects/cluster.module.css';
import shell from '../styles/layout/shell.module.css';
import { withBase } from '../lib/content';
import styles from './BaseLayout.module.css';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type: posts are articles, everything else is part of the site. */
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Hacker Newsletter issues, digested: article and comment summaries.',
  type = 'website',
} = Astro.props;
const fullTitle = title ? `${title} · HN Digest` : 'HN Digest';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="HN Digest" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? 'HN Digest'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class={shell.shell}>
    <header class={shell.header}>
      <div class:list={[center.center, cluster.cluster, cluster.spread]}>
        <div class={cluster.cluster}>
          <a class={styles.brand} href={withBase('/')}>
            <span class={styles.logo} aria-hidden="true">
              Y
            </span>
            HN Digest
          </a>
          <span class={styles.tagline}>Hacker Newsletter, digested</span>
        </div>
        <nav class:list={[cluster.cluster, styles.nav]} aria-label="Site">
          <SearchForm />
          <a href={withBase('/favorites/')}>Favorites</a>
        </nav>
      </div>
    </header>
    <main class={shell.main}>
      <div class={center.center}>
        <slot />
      </div>
    </main>
    <footer class={shell.footer}>
      <div class={center.center}>
        Summaries are generated from each article and its Hacker News thread; quotes link to the
        original comments.
      </div>
    </footer>
  </body>
</html>
